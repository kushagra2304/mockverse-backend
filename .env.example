# MockVerse Backend Environment Variables

# Server Configuration
PORT=5001
FRONTEND_URL=http://localhost:5173

# JWT Secret for Session & Token Authentication (use a strong random 32+ character string)
JWT_SECRET=your_super_secret_jwt_key_here

# MySQL Database Configuration (Aiven / Local MySQL / AWS RDS)
DB_HOST=your-mysql-host.aivencloud.com
DB_USER=avnadmin
DB_PASSWORD=your_database_password
DB_NAME=defaultdb
DB_PORT=3306
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
# Optional: path to SSL CA cert (defaults to ./ca.pem if present)
# DB_CA_PATH=./ca.pem

# Google Gemini API Key for AI Mock Interview Question Generation & Answer Evaluation
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Judge0 Code Execution API via RapidAPI
# Subscribe to Judge0 CE on RapidAPI: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_KEY=your_rapidapi_judge0_api_key_here
JUDGE0_HOST=judge0-ce.p.rapidapi.com
